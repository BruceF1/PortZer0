@model IEnumerable<PortZer0.Models.BlogPost>

@{
    ViewData["Title"] = "Home Page";
}

<div>
    <h2 class="display-4">▪[x x]▪</h2>
    <p>PortZerø</p>

    <h3>Read:</h3>

    @if (Model != null && Model.Any())
    {
        <ol>
            @foreach (var post in Model)
            {
                <li class="h5">
                    <div>
                        <div>@post.Title</div>
                        <p>Description</p>
                    </div>
                </li>
            }
        </ol>
    }
    else
    {
        <p>No posts yet. Stay tuned.</p>
    }

    <p>> No entry. No leaks.</p>
    <p>Access denied since day Ø</p>
    <p>Instagram: <a href="https://instagram.com" target="_blank">Click here</a></p>
    <p>Mastodon: <a href="https://mastodon.social" target="_blank">Click here</a></p>
</div>

@model IEnumerable<PortZer0.Models.BlogPost>

<div class="container">
    <h2 class="display-4">Posts</h2>
    <!-- Fixed headings -->
    <div class="row fw-bold border-bottom py-2">
        <div class="col">Title</div>
        <div class="col">Actions</div>
    </div>

    <!-- Blog post rows -->
    @foreach (var post in Model)
    {
        <div class="row align-items-center py-2 border-bottom">
            <div class="col">@post.Title</div>
            <div class="col">
                <a asp-action="Edit" asp-route-id="@post.Id" role="button">Edit</a>

                <form asp-controller="BlogPosts" asp-action="Delete" asp-route-id="@post.Id" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-outline-neon btn-sm mb-4" type="submit">Delete</button>
                </form>

            </div>
        </div>
    }
</div>

<!-- Quill CSS and JS CDN -->
<link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet" />
<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>

<script>
    // Initialize Quill editor
    var quill = new Quill('#quillEditor', {
      theme: 'snow'
    });

    // On form submit, copy Quill HTML content into hidden input
    function submitHandler(event) {
      // Copy HTML content to hidden input so it gets posted
      var content = document.querySelector('#Content');
      content.value = quill.root.innerHTML;
    }
</script>
